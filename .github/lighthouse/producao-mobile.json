{
  "ci": {
    "collect": {
      "url": ["https://dmarcfacil.ryanmorais.com.br/"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "skipAudits": ["robots-txt"]
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "color-contrast": [
          "error",
          {
            "minScore": 1
          }
        ],
        "errors-in-console": [
          "error",
          {
            "minScore": 1
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 153600
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/producao-mobile"
    }
  }
}

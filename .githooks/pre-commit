#!/usr/bin/env bash
#
# Hook de pre-commit (versionado): portão de qualidade do DMARC Fácil.
#
# Roda a mesma sequência do CI em modo VERIFICAÇÃO (não altera arquivos): se passa aqui,
# passa no job `qualidade`. Aborta o commit se qualquer etapa falhar. É o portão que vale
# enquanto a `main` ainda não tem ruleset exigindo o CI.
#
# ATIVAÇÃO (uma vez por clone):
#     git config core.hooksPath .githooks
#
# Pré-requisito: dependências instaladas com `pnpm install`.

set -euo pipefail

#######################################
# Roda as etapas do portão, na ordem do CI.
# Globals:
#   nenhuma
# Arguments:
#   nenhum
# Outputs:
#   uma linha por etapa e a saída da ferramenta, em STDOUT
# Returns:
#   0 se todas passam; o código da primeira etapa que falha (o `set -e` aborta)
#######################################
main() {
  echo "[pre-commit] prettier --check..."
  pnpm format:check

  echo "[pre-commit] eslint..."
  pnpm lint

  echo "[pre-commit] tsc --noEmit..."
  pnpm typecheck

  echo "[pre-commit] testes..."
  pnpm test

  echo "[pre-commit] OK."
}

main "$@"
